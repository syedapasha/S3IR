% num_heptahedra = size(heptahedra,1);
% 
% % Find nodes forming heptahedra
% idt = unique(heptahedra);
% S = numel(idt);
% 
% % Initialize node-to-facet degree (size based on the maximum node index)
% node_to_facet_degree_hepta = zeros(S,1);
% 
% % Count the occurrences of each node in a heptahedra
% for s = 1:S
%     node_to_facet_degree_hepta(s) = sum(sum(heptahedra == idt(s)));
% end
% 
% avg_facet_degree = sum(node_to_facet_degree_hepta)/N;     % divide by S or N?
% 
% %disp(['Average node-to-facet degree (heptahedra): ', num2str(avg_facet_degree)]);
% %disp(heptahedra);


% %%
octahedra = [];
octahedra_sorted = [0 0 0 0 0 0 0 0];  

for i = 1:N

    ni = links{i};

    for j = 1:length(ni)
        for k = j+1:length(ni)
            for el = k+1:length(ni)
              for m = el+1:length(ni)
                  for p=m+1:length(ni)
                      for q=p+1:length(ni)
                          for r=q+1:length(ni)

               if AM(ni(j),ni(k))==1 && AM(ni(k),ni(el))==1 && AM(ni(j),ni(el))==1 && ...
                       AM(ni(j),ni(m))==1  && AM(ni(m),ni(k))==1  && AM(ni(el),ni(m))==1 && ...
                       AM(ni(j), ni(p))==1 && AM(ni(k), ni(p))==1 && AM(ni(el),ni(p))==1 && AM(ni(m),ni(p))==1 &&...
                       AM(ni(j), ni(q))==1 && AM(ni(k), ni(q))==1 && AM(ni(el), ni(q))==1 && ...
                       AM(ni(m), ni(q))==1 && AM(ni(p), ni(q))==1 && AM(ni(j), ni(r))==1 && AM(ni(k), ni(r))==1 && ...
                       AM(ni(el), ni(r))==1 && AM(ni(m), ni(r))==1 && AM(ni(p), ni(r))==1 && AM(ni(q), ni(r))==1
                    candidate = sort([id(i) ni(j) ni(k) ni(el) ni(m) ni(p) ni(q) ni(r)]);
                    idx = find(octahedra_sorted==candidate);
                    
                    if isempty(idx)     % only add if any permutation is not in the list  
                        octahedra = [octahedra; id(i) ni(j) ni(k) ni(el) ni(m) ni(p) ni(q) ni(r)];
                        octahedra_sorted = [ octahedra_sorted; candidate ];
                    end
               end
                          end
                      end
                 end 
              end

            end
        end
    end

end
num_octahedra = size(octahedra,1);

% Find nodes forming octahedra
idt = unique(octahedra);
S = numel(idt);

% Initialize node-to-facet degree (size based on the maximum node index)
node_to_facet_degree_octa = zeros(S,1);

% Count the occurrences of each node in a octahedra
for s = 1:S
    node_to_facet_degree_octa(s) = sum(sum(octahedra == idt(s)));
end

avg_facet_degree = sum(node_to_facet_degree_octa)/N;     % divide by S or N?

%disp(['Average node-to-facet degree (octahedra): ', num2str(avg_facet_degree)]);
%disp(octahedra);


